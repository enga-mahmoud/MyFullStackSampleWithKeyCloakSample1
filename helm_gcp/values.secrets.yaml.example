# =============================================================================
# values.secrets.yaml.example
# =============================================================================
# Copy this file to values.secrets.yaml, fill in base64-encoded real passwords,
# and keep values.secrets.yaml out of git (add it to .gitignore).
#
# Generate a base64 value:
#   Linux/macOS: echo -n "your-password" | base64
#   PowerShell:  [Convert]::ToBase64String([System.Text.Encoding]::UTF8.GetBytes("your-password"))
#
# Pass to Helm:
#   helm install myapp ./helm_gcp \
#     --namespace myapp --create-namespace \
#     --values helm_gcp/values.secrets.yaml
#
# IMPORTANT: ORDER_SERVICE_CLIENT_SECRET must match the "secret" value for
# order-service-client inside templates/configmaps/keycloak-realm-cm.yaml.
# If you rotate this secret you must update both places.
# =============================================================================

secrets:
  keycloakDbPassword:    ""   # KC_DB_PASSWORD           — Keycloak database password
  keycloakAdmin:         ""   # KEYCLOAK_ADMIN           — Keycloak admin username (base64 of "admin")
  keycloakAdminPassword: ""   # KEYCLOAK_ADMIN_PASSWORD  — Keycloak admin console password
  userDbPassword:        ""   # USER_DB_PASSWORD         — user-service database password
  productDbPassword:     ""   # PRODUCT_DB_PASSWORD      — product-service database password
  orderDbPassword:       ""   # ORDER_DB_PASSWORD        — order-service database password
  orderClientSecret:     ""   # ORDER_SERVICE_CLIENT_SECRET — order-service Keycloak client secret
  configServerPassword:  ""   # CONFIG_SERVER_PASSWORD   — Config Server HTTP Basic password
  grafanaAdminPassword:  ""   # GF_SECURITY_ADMIN_PASSWORD — Grafana admin password
