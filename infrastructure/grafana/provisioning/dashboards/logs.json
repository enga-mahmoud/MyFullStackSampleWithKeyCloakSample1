{
  "id": null,
  "uid": "service-logs",
  "title": "Service Logs",
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "app",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(app)",
        "label": "Service",
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "level",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(level)",
        "label": "Level",
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log Volume by Service and Level",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (app, level) (count_over_time({app=~\"$app\", level=~\"$level\"}[1m]))",
          "legendFormat": "{{app}} [{{level}}]",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 1, "fillOpacity": 10 } }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{app=~\"$app\", level=~\"$level\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": false,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true
      },
      "gridPos": { "h": 22, "w": 24, "x": 0, "y": 7 }
    }
  ]
}
